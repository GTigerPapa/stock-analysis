{"code":"0218L0","name":"네오뷰","market":"KOSDAQ","sector_name":"디스플레이장비및부품","sector_desc":"디스플레이 제조 장비와 부품·소재. 패널 업체의 설비 투자 사이클에 실적이 몰립니다.","desc":"차량 내 편의성과 엔터테인먼트적 요소가 중요해지면서 다양한 형태의 차량용 디스플레이 제작을 주 사업으로 영위함. 2020년에는 중국 대련에 차량용 전장 디스플레이 생산라인 구축에 투자하여 2021년Set-up을 완료하였고, 동년 LG디스플레이에 차량용 전장 디스플레이를 양산하여 공급함. 신기술·신제품 개발과 고객사 확보, 수주 확대에 따라 2024년부터는 생산라인 증설 투자를 본격화함.","f":{"date":"2026-10-22","n_days":59,"close":12200.0,"open":12020.0,"high":12710.0,"low":11580.0,"volume":6908,"amount":84277600.0,"ret_1d":-1.9293,"gap":-3.3762,"range_pct":9.2623,"ret_5":7.0175,"ret_20":-2.008,"ret_60":null,"ret_120":null,"ret_250":null,"ma20":12198.0,"ma60":null,"ma120":null,"ma200":null,"close_vs_ma200":null,"close_vs_ma60":null,"ma_align":0,"cross_ma200_20d":null,"slope_60":null,"r2_60":null,"slope_120":null,"r2_120":null,"slope_250":null,"r2_250":null,"high52":25600.0,"low52":10870.0,"pos_52w":9.0292,"dd_52w":-52.3438,"mdd_1y":-36.4903,"atr14_pct":8.0913,"vol_ann_60":65.4907,"vol_avg20":17994.45,"vol_ratio20":0.3839,"vr5":null,"vr20":null,"amount_avg5":275249840.0,"amount_avg20":215624021.5,"amount_avg60":3266740298.1356,"obv_chg20":22.0165,"turnover_20":6.821,"pv_eff_20":-0.2944,"rsi14":40.485,"frgn_net_5":57953.0,"inst_net_5":1812.0,"frgn_net_5_pct":1.0984,"inst_net_5_pct":0.0343,"smart_net_5_pct":1.1327,"frgn_net_20":70958.0,"inst_net_20":-9840.0,"frgn_net_20_pct":1.3449,"inst_net_20_pct":-0.1865,"smart_net_20_pct":1.1584,"frgn_net_60":-121281.0,"inst_net_60":46446.0,"frgn_net_60_pct":-2.2987,"inst_net_60_pct":0.8803,"smart_net_60_pct":-1.4184,"frgn_net_120":null,"inst_net_120":null,"frgn_net_120_pct":null,"inst_net_120_pct":null,"smart_net_120_pct":null,"foreign_ratio":17.16,"foreign_ratio_chg_60":null,"smart_buy_streak":0,"op_income_q":null,"op_margin_q":null,"op_qoq":null,"op_turnaround":null,"op_yoy":null,"rev_yoy":null,"op_trend_4q":null,"fin_period":null,"roe":null,"debt_ratio":null,"per":null,"pbr":null,"div_yield":null,"foreign_rate":17.23,"target_price":null,"recomm":null,