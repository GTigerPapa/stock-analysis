{"code":"308170","name":"씨티알모빌리티","market":"KOSPI","sector_name":"자동차부품","sector_desc":"완성차에 들어가는 부품 제조. 완성차 생산량과 전동화(EV) 전환 속도, 환율의 영향을 받습니다.","desc":"동사는 2019년 유가증권시장에 상장한 자동차 부품 전문 기업으로, 종속회사인 씨티알에코포징을 보유하고 있음. 울산공장(본사), 대구공장, 서산공장 및 종속회사의 밀양공장에서 구동장치와 현가장치를 생산하여 현대차그룹과 자동차 부품업체 및 해외 완성차업체에 납품하고 있음. 구동부품으로는 로터샤프트, 이너레이스, 오디 클러치보스, 볼스크류, 프로펠라샤프트를, 현가부품으로는 엑슬, 컨트롤 암 등을 생산하고 있음.","f":{"date":"2026-10-30","n_days":300,"close":4655.0,"open":5120.0,"high":5470.0,"low":4375.0,"volume":1150200,"amount":5354181000.0,"ret_1d":-8.9041,"gap":0.1957,"range_pct":23.5231,"ret_5":52.1242,"ret_20":36.7107,"ret_60":26.6667,"ret_120":-10.9943,"ret_250":-5.3862,"ma20":3506.0,"ma60":3550.0833,"ma120":3707.6667,"ma200":4692.775,"close_vs_ma200":-0.805,"close_vs_ma60":31.1237,"ma_align":0,"cross_ma200_20d":0.0,"slope_60":-17.2957,"r2_60":0.0235,"slope_120":-36.6908,"r2_120":0.2466,"slope_250":-48.7045,"r2_250":0.5102,"high52":10200.0,"low52":2900.0,"pos_52w":24.0411,"dd_52w":-54.3627,"mdd_1y":-68.0968,"atr14_pct":10.534,"vol_ann_60":95.2203,"vol_avg20":251261.5,"vol_ratio20":4.5777,"vr5":151.6499,"vr20":14.8589,"amount_avg5":4526105409.0,"amount_avg20":1144862738.25,"amount_avg60":395785465.4167,"obv_chg20":-10.3557,"turnover_20":58.365,"pv_eff_20":0.629,"rsi14":67.6568,"frgn_net_5":-18634.0,"inst_net_5":-192.0,"frgn_net_5_pct":-0.2164,"inst_net_5_pct":-0.0022,"smart_net_5_pct":-0.2187,"frgn_net_20":-27739.0,"inst_net_20":-9.0,"frgn_net_20_pct":-0.3222,"inst_net_20_pct":-0.0001,"smart_net_20_pct":-0.3223,"frgn_net_60":-50465.0,"inst_net_60":768.0,"frgn_net_60_pct":-0.5861,"inst_net_60_pct":0.0089,"smart_net_60_pct":-0.5772,"frgn_net_120":-136020.0,"inst_net_120":-8853.0,"frgn_net_120_pct":-1.5798,"inst_net_120_pct":-0.1028,"smart_net_120_pct":-1.6826,"foreign_ratio":0.81,"foreign_ratio_chg_60":-0.66,"smart_buy_streak":2,"op_income_q":12.0,"op_margin_q":1.0508,"op_qoq":300.0,"op_turnaround":0.0,"op_yoy":-42.8571,"rev_yoy":-7.4554,"op_trend_4q":-15.2381,"fin_period":"202606","roe":-5.53,