{"code":"351870","name":"차이커뮤니케이션","market":"KOSDAQ","sector_name":"광고","sector_desc":"광고 대행·디지털 마케팅. 기업 광고 예산과 경기에 연동됩니다.","desc":"동사는 2004년 설립된 디지털 종합 광고대행업을 영위하는 독립광고회사로, 2024년 코스닥시장에 상장하였음. 2025년 의료기관 마케팅 대행 및 의료기기·화장용품 도소매업을 영위하는 '주식회사 더에쓰씨'를 종속회사로 취득하였음. 동사는 디지털 기반 브랜드 캠페인, 퍼포먼스 마케팅, 콘텐츠 제작 등 통합 마케팅 서비스를 제공하며, TV방송광고 및 온·오프라인 캠페인까지 사업을 확장하고 있음.","f":{"date":"2026-10-21","n_days":300,"close":2210.0,"open":2320.0,"high":2320.0,"low":2130.0,"volume":11236,"amount":24831560.0,"ret_1d":2.7907,"gap":7.907,"range_pct":8.5973,"ret_5":-5.1502,"ret_20":-8.6777,"ret_60":37.2671,"ret_120":-46.4891,"ret_250":-62.1575,"ma20":2286.0,"ma60":2163.4333,"ma120":2475.1417,"ma200":3223.86,"close_vs_ma200":-31.4486,"close_vs_ma60":2.1524,"ma_align":0,"cross_ma200_20d":0.0,"slope_60":334.4761,"r2_60":0.4536,"slope_120":-64.9896,"r2_120":0.2863,"slope_250":-70.1769,"r2_250":0.7993,"high52":6190.0,"low52":1501.0,"pos_52w":15.1205,"dd_52w":-64.2973,"mdd_1y":-73.9238,"atr14_pct":12.4919,"vol_ann_60":117.2851,"vol_avg20":16470.45,"vol_ratio20":0.6822,"vr5":0.2144,"vr20":0.4308,"amount_avg5":22940319.0,"amount_avg20":38822334.75,"amount_avg60":116297780.4333,"obv_chg20":-8.0329,"turnover_20":2.9515,"pv_eff_20":-2.9401,"rsi14":47.4323,"frgn_net_5":3296.0,"inst_net_5":0.0,"frgn_net_5_pct":0.0295,"inst_net_5_pct":0.0,"smart_net_5_pct":0.0295,"frgn_net_20":827.0,"inst_net_20":0.0,"frgn_net_20_pct":0.0074,"inst_net_20_pct":0.0,"smart_net_20_pct":0.0074,"frgn_net_60":-37869.0,"inst_net_60":-199.0,"frgn_net_60_pct":-0.3393,"inst_net_60_pct":-0.0018,"smart_net_60_pct":-0.3411,"frgn_net_120":-16644.0,"inst_net_120":0.0,"frgn_net_120_pct":-0.1491,"inst_net_120_pct":0.0,"smart_net_120_pct":-0.1491,"foreign_ratio":0.87,"foreign_ratio_chg_60":-0.35,"smart_buy_streak":3,"op_income_q":28.0,"op_margin_q":10.6061,"op_qoq":411.1111,"op_turnaround":1.0,"op_yoy":833.3333,"rev_yoy":129.5652,"op_trend_4q":7.5676,"fin_period":"202606","roe":-1.94,"debt_ratio":208.19,"per":null,"pbr":0.46,"div_yield":null,"forei