{"code":"051390","name":"YW","market":"KOSDAQ","sector_name":"판매업체","sector_desc":"도매·유통 판매업. 거래 물량과 마진이 실적을 결정합니다.","desc":"동사는 1995년 설립되어 2001년 코스닥시장에 상장된 유·무선 종합 정보통신회사로, 주로 도매업 및 기업금융 사업을 영위하고 있음. 렌탈사업은 기업고객 대상으로 OA기기, 가전제품, 의료기기, 산업장비 등을 약 3년 약정으로 렌탈서비스 제공함. 기업금융부문은 회사채 매입 및 대출로 유휴자금을 운용하며, 2015년부터 렌탈품목 확장 및 제휴를 통해 경쟁력을 강화하고 있음.","f":{"date":"2026-10-19","n_days":298,"close":3940.0,"open":3785.0,"high":3950.0,"low":3780.0,"volume":1175,"amount":4629500.0,"ret_1d":4.7872,"gap":0.6649,"range_pct":4.3147,"ret_5":-1.005,"ret_20":-4.6005,"ret_60":3.9578,"ret_120":-9.3211,"ret_250":-0.2532,"ma20":3970.5,"ma60":3984.3667,"ma120":4127.1833,"ma200":4090.51,"close_vs_ma200":-3.6795,"close_vs_ma60":-1.1135,"ma_align":0,"cross_ma200_20d":0.0,"slope_60":-2.2414,"r2_60":0.0032,"slope_120":-26.7889,"r2_120":0.4782,"slope_250":3.4573,"r2_250":0.033,"high52":4895.0,"low52":3600.0,"pos_52w":26.2548,"dd_52w":-19.5097,"mdd_1y":-22.3505,"atr14_pct":4.8042,"vol_ann_60":28.252,"vol_avg20":4944.0,"vol_ratio20":0.2377,"vr5":0.4995,"vr20":0.463,"amount_avg5":11150928.0,"amount_avg20":19649093.25,"amount_avg60":22460228.1,"obv_chg20":17.8439,"turnover_20":0.8708,"pv_eff_20":-5.2832,"rsi14":49.2204,"frgn_net_5":-1892.0,"inst_net_5":3500.0,"frgn_net_5_pct":-0.0167,"inst_net_5_pct":0.0308,"smart_net_5_pct":0.0142,"frgn_net_20":1647.0,"inst_net_20":22361.0,"frgn_net_20_pct":0.0145,"inst_net_20_pct":0.1969,"smart_net_20_pct":0.2114,"frgn_net_60":6801.0,"inst_net_60":78126.0,"frgn_net_60_pct":0.0599,"inst_net_60_pct":0.688,"smart_net_60_pct":0.7479,"frgn_net_120":112405.0,"inst_net_120":264093.0,"frgn_net_120_pct":0.9899,"inst_net_120_pct":2.3257,"smart_net_120_pct":3.3156,"foreign_ratio":2.3,"foreign_ratio_chg_60":0.06,"smart_buy_streak":0,"op_income_q":12.0,"op_margin_q":40.0,"op_qoq":20.0,"op_turnaround":0.0,"op_yoy":-14.2857,"rev_yoy":-37.5,"op_trend_4q":-12.8302,"fin_period":"202606","roe":5.88,"debt_ratio":15.92,"per":9.21,"pbr":0.38,"div_yield":5.84,"foreign_rate":2.3,"target_price":nul