{"code":"123570","name":"이엠넷","market":"KOSDAQ","sector_name":"광고","sector_desc":"광고 대행·디지털 마케팅. 기업 광고 예산과 경기에 연동됩니다.","desc":"동사는 2000년 설립되어 2011년 코스닥시장에 상장한 디지털 마케팅 전문 기업이며, 종속회사로 ㈜더브록스, 코마스인터렉티브, ㈜에버런스를 보유함. 2021년 eMnet Japan 지분을 전략적으로 일부 처분해 관계기업으로 전환하고, 소프트뱅크와 협력을 통해 아시아 시장 중심으로 글로벌 사업을 지속하고 있음. 2025년 중소형 광고주 대상 디지털 마케팅 전문 기업인 ㈜에버런스를 자회사로 편입하여 사업 포트폴리오를 확대하고 있음.","f":{"date":"2026-10-21","n_days":300,"close":1620.0,"open":1551.0,"high":1620.0,"low":1528.0,"volume":5704,"amount":9240480.0,"ret_1d":-0.4302,"gap":-4.6712,"range_pct":5.679,"ret_5":1.3133,"ret_20":-6.0325,"ret_60":-2.1148,"ret_120":-20.3931,"ret_250":-24.826,"ma20":1633.65,"ma60":1646.0667,"ma120":1732.5,"ma200":1815.71,"close_vs_ma200":-10.7787,"close_vs_ma60":-1.5836,"ma_align":0,"cross_ma200_20d":0.0,"slope_60":-8.6757,"r2_60":0.1158,"slope_120":-33.977,"r2_120":0.7004,"slope_250":-22.3589,"r2_250":0.7722,"high52":2390.0,"low52":1516.0,"pos_52w":11.8993,"dd_52w":-32.2176,"mdd_1y":-27.6347,"atr14_pct":5.9039,"vol_ann_60":28.8382,"vol_avg20":3806.65,"vol_ratio20":1.4984,"vr5":0.8437,"vr20":0.2948,"amount_avg5":8020696.0,"amount_avg20":6208754.8,"amount_avg60":9895172.0667,"obv_chg20":-55.6907,"turnover_20":0.3418,"pv_eff_20":-17.6507,"rsi14":48.154,"frgn_net_5":4126.0,"inst_net_5":0.0,"frgn_net_5_pct":0.0185,"inst_net_5_pct":0.0,"smart_net_5_pct":0.0185,"frgn_net_20":-4030.0,"inst_net_20":6630.0,"frgn_net_20_pct":-0.0181,"inst_net_20_pct":0.0298,"smart_net_20_pct":0.0117,"frgn_net_60":-18049.0,"inst_net_60":97746.0,"frgn_net_60_pct":-0.081,"inst_net_60_pct":0.4388,"smart_net_60_pct":0.3578,"frgn_net_120":-53086.0,"inst_net_120":386016.0,"frgn_net_120_pct":-0.2383,"inst_net_120_pct":1.7329,"smart_net_120_pct":1.4946,"foreign_ratio":27.65,"foreign_ratio_chg_60":-0.06,"smart_buy_streak":4,"op_income_q":2.0,"op_margin_q":2.439,"op_qoq":0.0,"op_turnaround":0.0,"op_yoy":null,"rev_yoy":1.2346,"op_trend_4q":8.0,"fin_period":"202606","roe":2.15,"debt_ratio":44.08,"per":17.42,"pbr":0.36,"div_yield":3.7,"fore