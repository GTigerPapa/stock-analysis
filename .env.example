# 복사해서 .env 로 저장 (절대 git에 커밋하지 말 것)
# 한국투자증권 KIS Developers — 실전투자 앱키 (시세 조회용)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# KRX 데이터포털 로그인 (pykrx 수급/업종용, 선택)
KRX_ID=
KRX_PW=
# 수집 병렬도 (네이버 API 동시 요청 수). 차단되면 낮출 것
STOCKAN_WORKERS=6
# OpenDART 인증키 (선택) — 종목 상세의 지분 구성 추이(최대주주·국민연금)에 사용. https://opendart.fss.or.kr
DART_API_KEY=
